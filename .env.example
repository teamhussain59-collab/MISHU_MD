# Copy to .env locally. Never commit real credentials or session files.
OWNER_NUMBER=923001234567
# Optional: set privately for non-interactive pairing; digits only with country code
PAIRING_NUMBER=
BOT_PREFIX=.
SESSION_DIR=auth_info
LOG_LEVEL=warn

# Optional automations (OFF by default)
AUTO_STATUS_SEEN=false
AUTO_REACT=false
AUTO_REACT_EMOJI=✨

# Anti-spam safety: minimum delay between owner commands
COMMAND_COOLDOWN_MS=3000
